root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 100

[*.{rs,toml}]
indent_size = 4
max_line_length = 100

[*.{md,yml,yaml,json}]
indent_size = 2
max_line_length = 100

[*.{ps1}]
end_of_line = crlf
indent_size = 4

[*.sh]
indent_size = 2

[Makefile]
indent_style = tab
